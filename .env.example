# Example environment variables
# Copy this file to .env and fill in your actual values

# Groq API Key - Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
# Leave DATABASE_URL commented to use local DuckDB
# Uncomment and set to use Supabase PostgreSQL database
#Comment out the line below if you want to use local DuckDB
DATABASE_URL=postgresql://postgres:your-password@db.xxxxx.supabase.co:5432/postgres


